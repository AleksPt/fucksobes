---
import RandomQuestion from '../components/RandomQuestion.tsx';
import Base from '../layouts/Base.astro';
import { ui } from '../i18n';
import { getQuestions, hasAnswer, questionSlug } from '../lib/content';
import { toLocale } from '../lib/locale';
import { url } from '../lib/url';

const locale = toLocale(Astro.currentLocale);
const t = ui[locale];

// На странице только список id: сам вопрос и ответ RandomQuestion грузит из random/<id>.json.
const ids = (await getQuestions(undefined, locale)).filter(hasAnswer).map(questionSlug);
---

<Base title={`${t.randomQuestion} — FuckSobes`}>
  <div class="mx-auto max-w-3xl">
    <nav class="text-sm text-fog">
      <a href={url('', locale)} class="hover:text-accent">{t.categories}</a>
      <span class="mx-1 text-steel">/</span>
      <span>{t.randomQuestion}</span>
    </nav>
    <RandomQuestion client:load ids={ids} locale={locale} />
  </div>
</Base>
