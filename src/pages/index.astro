---
import CategoryCard from '../components/CategoryCard.astro';
import Base from '../layouts/Base.astro';
import { getCategories, getQuestions } from '../lib/content';
import { pluralize } from '../lib/text';

const categories = await getCategories();
const questions = await getQuestions();
const stats = categories.map((category) => ({
  category,
  total: questions.filter((q) => q.data.category.id === category.id).length,
}));
---

<Base title="FuckSobes — вопросы к iOS-собеседованиям">
  <h1 class="pt-8 pb-14 text-center">
    <span class="text-signal block pb-[0.06em] text-[clamp(3rem,12vw,8rem)] leading-none font-bold tracking-[-0.045em]"
      >{`${questions.length} ${pluralize(questions.length, ['вопрос', 'вопроса', 'вопросов'])}`}</span
    >
    <span class="mt-3 block text-[clamp(1.25rem,3.4vw,2.25rem)] leading-tight font-medium tracking-tight">с реальных собеседований</span>
  </h1>
  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      stats.map(({ category, total }) => (
        <li>
          <CategoryCard category={category} total={total} />
        </li>
      ))
    }
  </ul>
</Base>
