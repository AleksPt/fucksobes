---
import CategoryCard from '../components/CategoryCard.astro';
import Base from '../layouts/Base.astro';
import { getCategories, getQuestions } from '../lib/content';
import { pluralize } from '../lib/text';
import { url } from '../lib/url';

const categories = await getCategories();
const questions = await getQuestions();
const stats = categories.map((category) => ({
  category,
  total: questions.filter((q) => q.data.category.id === category.id).length,
}));
---

<Base title="FuckSobes — вопросы к iOS-собеседованиям" hero>
  <h1 class="pt-12 text-center sm:pt-20">
    <span class="block font-display text-[clamp(4.5rem,14vw,11.25rem)] leading-[0.85] font-semibold tracking-[-0.02em] text-balance uppercase"
      >{`${questions.length} ${pluralize(questions.length, ['вопрос', 'вопроса', 'вопросов'])}`}</span
    >
    <span class="mt-6 block text-[clamp(1.375rem,3vw,1.75rem)] leading-tight font-medium tracking-[-0.02em] text-balance text-paper/85 sm:whitespace-nowrap"
      >с реальных iOS-собеседований</span
    >
  </h1>
  <p class="flex flex-wrap items-center justify-center gap-3 pt-10 pb-16 sm:pb-24">
    <a
      href={url('random/')}
      class="inline-flex items-center rounded-input bg-accent px-6 py-3 text-base font-medium text-on-accent transition-opacity hover:opacity-90 motion-reduce:transition-none"
      >Случайный вопрос</a
    >
    <a
      href={url('tutorials/')}
      class="inline-flex items-center rounded-input border border-white/45 px-6 py-3 text-base font-medium transition-colors hover:border-accent hover:text-accent motion-reduce:transition-none"
      >Туториалы</a
    >
  </p>
  <ul class="flex flex-wrap gap-4 [&>li]:grow [&>li]:basis-[20rem]">
    {
      stats.map(({ category, total }) => (
        <li>
          <CategoryCard category={category} total={total} />
        </li>
      ))
    }
  </ul>
</Base>
