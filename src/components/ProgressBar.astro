---
interface Props {
  value: number;
  max: number;
  label: string;
}

const { value, max, label } = Astro.props;
const percent = max > 0 ? Math.round((value / max) * 100) : 0;
---

<div class="h-1 overflow-hidden rounded-full bg-smoke" role="img" aria-label={`${label}: ${percent}%`}>
  <div class="h-full rounded-full bg-linear-to-r from-accent-dim to-accent" style={`width: ${percent}%`}></div>
</div>
