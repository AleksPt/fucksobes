---
import { url } from '../lib/url';
import Logo from './Logo.astro';
import Search from './Search.tsx';
---

<header class="sticky top-0 z-20 px-4 pt-4 sm:px-6">
  <div
    class="mx-auto flex max-w-4xl items-center gap-3 rounded-nav border border-white/8 bg-carbon py-2 pr-2 pl-4 shadow-nav sm:gap-6 sm:pl-6"
  >
    <a href={url()} class="shrink-0 text-accent" aria-label="FuckSobes, на главную">
      <Logo class="h-4 w-auto sm:h-5" />
    </a>
    <Search client:idle transition:persist="search" indexUrl={url('search-index.json')} />
  </div>
</header>
