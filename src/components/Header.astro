---
import { url } from '../lib/url';
import Logo from './Logo.astro';
import Search from './Search.tsx';
---

<header class="relative z-20px-4 pt-4 sm:px-6">
  <div
    class="mx-auto flex max-w-page items-center gap-3 rounded-nav bg-paper py-2 pr-2 pl-4 text-on-accent sm:gap-6 sm:pl-5"
  >
    <a href={url()} class="shrink-0 rounded-input text-on-accent" aria-label="FuckSobes, на главную">
      <Logo class="h-4 w-auto sm:h-5" />
    </a>
    <Search client:idle transition:persist="search" indexUrl={url('search-index.json')} />
  </div>
</header>
