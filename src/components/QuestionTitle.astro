---
import { splitInlineCode } from '../lib/text';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

{
  splitInlineCode(title).map((part) =>
    part.code ? (
      <code class="rounded-md bg-smoke px-1.5 py-0.5 font-mono text-[0.9em]">{part.text}</code>
    ) : (
      part.text
    ),
  )
}
